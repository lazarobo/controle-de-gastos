{
  "expo": {
    "name": "Controle de Gastos",
    "slug": "controle-de-gastos",
    "version": "1.3.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lazaro.controledegastos"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-sharing",
      "expo-notifications",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Atalho",
              "label": "Controle de Gastos — atalhos",
              "description": "Registrar gasto ou receita em um toque",
              "minWidth": "180dp",
              "minHeight": "48dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "resizeMode": "horizontal"
            },
            {
              "name": "Saldo",
              "label": "Controle de Gastos — saldo",
              "description": "Saldo total e resultado do mês",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "scheme": "controledegastos",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f7966e2f-47c7-4dc6-a9de-8f6c94338c6d"
      }
    }
  }
}
